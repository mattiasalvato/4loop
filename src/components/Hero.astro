---
// src/components/Hero.astro

// Placeholder pronti per le immagini definitive indicate da Nicolò:
// 1. Pila capi usati | 2. Pannello o granulato | 3. Filato tessile
const imgLeft = "immagine-1.jpeg";
const imgCenter = "immagine-2.jpeg";
const imgRight = "immagine-3.jpeg";
---

<section class="relative w-full max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-20 sm:pb-24 flex flex-col items-center text-center overflow-visible">
  
  <!-- Pillola Header: pallini staccati e niente PHYGITAL -->
  <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-sm mb-6 select-none z-10">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-[#1d77f2]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#1cb829]"></span>
    </div>
    <span class="text-xs sm:text-sm font-extrabold tracking-tight text-[#111d27] uppercase">
      ECOSISTEMA CIRCOLARE
    </span>
  </div>

  <!-- Headline & Tracciati Vettoriali -->
  <div class="relative w-full max-w-3xl flex justify-center items-center py-6 my-2 select-none">
    
    <!-- Tracciati Vettoriali Cobalto e Smeraldo -->
    <svg 
      class="absolute inset-0 w-full h-full pointer-events-none -z-10 opacity-80"
      viewBox="0 0 700 350" 
      fill="none"
    >
      <path 
        d="M 50 180 C 150 70, 300 280, 500 130 S 680 250, 680 200" 
        stroke="#1d77f2" 
        stroke-width="2" 
        stroke-linecap="round"
      />
      <path 
        d="M 80 220 C 180 300, 340 100, 480 220 S 620 120, 650 160" 
        stroke="#1cb829" 
        stroke-width="2" 
        stroke-dasharray="5 5"
        stroke-linecap="round"
      />
    </svg>

    <!-- Titolo a font alternato sans/serif -->
    <div class="flex flex-col items-center leading-[0.92] tracking-tight z-10">
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black text-[#111d27] font-sans uppercase">
        DAI NUOVA
      </h1>
      <span class="text-5xl sm:text-7xl lg:text-8xl font-serif font-light text-[#111d27] tracking-wide my-[-2px]">
        VITA
      </span>
      <span class="text-5xl sm:text-7xl lg:text-8xl font-black text-[#111d27] font-sans uppercase">
        AI TUOI
      </span>
      <span class="text-5xl sm:text-7xl lg:text-8xl font-serif font-light text-[#111d27] tracking-[0.06em] uppercase">
        CAPI
      </span>
    </div>

    <!-- Foto Fluttuanti (nascoste su mobile) -->
    <div class="hidden sm:block floating-slow absolute -left-4 sm:-left-8 top-0 w-28 sm:w-36 h-36 sm:h-44 rounded-2xl overflow-hidden shadow-2xl shadow-[#111d27]/15 border-2 border-white -rotate-6 z-20 pointer-events-none">
      <img src={imgLeft} alt="Pila capi usati" class="w-full h-full object-cover" />
    </div>

    <div class="hidden sm:block floating-mid absolute left-14 sm:left-24 -bottom-8 w-32 sm:w-44 h-32 sm:h-36 rounded-2xl overflow-hidden shadow-2xl shadow-[#111d27]/20 border-2 border-white -rotate-2 z-20 pointer-events-none">
      <img src={imgCenter} alt="Pannello o granulato riciclato" class="w-full h-full object-cover" />
    </div>

    <div class="hidden sm:block floating-fast absolute -right-4 sm:-right-8 bottom-2 w-28 sm:w-36 h-36 sm:h-44 rounded-2xl overflow-hidden shadow-2xl shadow-[#111d27]/15 border-2 border-white rotate-6 z-20 pointer-events-none">
      <img src={imgRight} alt="Filato tessile rigenerato" class="w-full h-full object-cover" />
    </div>
  </div>

  <!-- Testi indicati da Nicolò -->
  <div class="max-w-2xl mt-10 sm:mt-12 mb-8 z-10 px-2">
    <p class="text-lg sm:text-xl font-bold text-[#111d27] tracking-tight mb-2">
      L'ecosistema pensato per chiudere il cerchio dei rifiuti tessili post-consumo.
    </p>
    <p class="text-sm sm:text-base text-slate-600 font-normal leading-relaxed">
      Un'infrastruttura trasparente per abilitare la gestione virtuosa e la valorizzazione dei rifiuti tessili.
    </p>
  </div>

  <!-- Pulsanti CTA -->
  <div class="flex flex-col sm:flex-row items-center gap-3.5 sm:gap-4 z-10 w-full sm:w-auto">
    <a
      href="#registrati"
      class="w-full sm:w-auto px-9 py-4 rounded-full bg-[#1cb829] hover:bg-[#18a224] text-white font-semibold text-base transition-all duration-150 transform hover:scale-[1.02] active:scale-95 shadow-md shadow-[#1cb829]/25 text-center"
    >
      Entra nella community
    </a>
    <a
      href="#processo"
      class="w-full sm:w-auto px-7 py-4 rounded-full bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold text-sm transition-all text-center"
    >
      Come funziona ↓
    </a>
  </div>

</section>

<style>
  @keyframes floatSlow {
    0%, 100% { transform: translateY(0px) rotate(-6deg); }
    50% { transform: translateY(-8px) rotate(-5deg); }
  }
  @keyframes floatMid {
    0%, 100% { transform: translateY(0px) rotate(-2deg); }
    50% { transform: translateY(-11px) rotate(-1deg); }
  }
  @keyframes floatFast {
    0%, 100% { transform: translateY(0px) rotate(6deg); }
    50% { transform: translateY(-7px) rotate(7deg); }
  }
  .floating-slow { animation: floatSlow 5s ease-in-out infinite; }
  .floating-mid { animation: floatMid 6s ease-in-out infinite 0.5s; }
  .floating-fast { animation: floatFast 4.5s ease-in-out infinite 1s; }
</style>