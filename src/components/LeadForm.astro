---
// src/components/LeadForm.astro
---

<section id="registrati" class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-20 sm:pb-32">
  <div class="w-full bg-[#111d27] text-white rounded-[2rem] sm:rounded-[2.5rem] p-6 sm:p-12 lg:p-14 border border-slate-800 text-center flex flex-col items-center shadow-2xl relative overflow-hidden">
    
    <div class="absolute -top-24 -left-20 w-72 sm:w-80 h-72 sm:h-80 bg-[#1d77f2]/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-20 w-72 sm:w-80 h-72 sm:h-80 bg-[#1cb829]/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#162738] border border-slate-700 mb-5 sm:mb-6 z-10 select-none">
      <span class="w-2 h-2 rounded-full bg-[#1cb829] animate-pulse"></span>
      <span class="text-[10px] sm:text-xs font-bold tracking-wider text-slate-200 uppercase">
        ACCESSO ANTICIPATO • POSTI LIMITATI
      </span>
    </div>

    <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-3 sm:mb-4 z-10">
      Unisciti alla rivoluzione circolare
    </h2>

    <p class="text-slate-300 text-xs sm:text-sm md:text-base max-w-lg mx-auto leading-relaxed mb-6 sm:mb-8 z-10">
      Entra in lista d'attesa: ricevi vantaggi esclusivi al lancio, accesso prioritario all'app e sconti dedicati con i nostri brand partner.
    </p>

    <form id="lead-capture-form" class="w-full max-w-md flex flex-col gap-3.5 z-10 text-left">
    

      <div class="flex flex-col sm:flex-row items-center gap-2">
        <input
          type="email"
          name="email"
          id="lead-email-input"
          required
          placeholder="Inserisci la tua email personale..."
          class="w-full px-4 sm:px-5 py-3 sm:py-3.5 rounded-full bg-white/10 border border-white/15 text-white placeholder-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#1cb829] transition-all"
        />
        <button
          type="submit"
          id="lead-submit-btn"
          class="w-full sm:w-auto shrink-0 px-7 py-3 sm:py-3.5 rounded-full bg-[#1cb829] hover:bg-[#18a224] text-white font-semibold text-xs sm:text-sm transition-all duration-150 active:scale-95 shadow-lg shadow-[#1cb829]/25 cursor-pointer text-center"
        >
          Blocca il posto
        </button>
      </div>

      <div class="flex items-center justify-between text-[10px] sm:text-[11px] text-slate-400 px-2">
        <span class="inline-flex items-center gap-1">
          <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-[#1cb829]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Zero spam garantito
        </span>
        <span>GDPR compliant</span>
      </div>
    </form>

    <div id="lead-success-msg" class="hidden flex-col items-center gap-2 z-10 py-6">
      <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#1cb829]/20 border border-[#1cb829] flex items-center justify-center text-[#1cb829] mb-1">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h3 class="text-lg sm:text-xl font-bold text-white">Sei in lista prioritaria!</h3>
      <p class="text-slate-300 text-xs sm:text-sm max-w-sm">
        Ti contatteremo in anteprima rispetto al lancio pubblico per attivare i tuoi vantaggi.
      </p>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('lead-capture-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('lead-success-msg');
  const submitBtn = document.getElementById('lead-submit-btn');
  const emailInput = document.getElementById('lead-email-input') as HTMLInputElement | null;
  const radios = document.querySelectorAll('input[name="user_type"]');

  radios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (!emailInput) return;
      if (val === 'cittadino') emailInput.placeholder = "Inserisci la tua email personale...";
      else if (val === 'brand') emailInput.placeholder = "nome@brand-fashion.com...";
      else if (val === 'pa') emailInput.placeholder = "nome.cognome@comune.ente.it...";
    });
  });

  if (form && successMsg && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.innerText = 'Invio...';
      submitBtn.setAttribute('disabled', 'true');

      try {
        await new Promise(res => setTimeout(res, 500));
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
        successMsg.classList.add('flex');
      } catch (err) {
        alert('Si è verificato un errore, riprova.');
        submitBtn.removeAttribute('disabled');
        submitBtn.innerText = 'Blocca il posto';
      }
    });
  }
</script>