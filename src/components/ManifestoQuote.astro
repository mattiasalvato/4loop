---
// src/components/ManifestoQuote.astro
---

<section class="w-full max-w-6xl mx-auto px-6 py-20 sm:py-28 text-center flex flex-col items-center relative">
  <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200/80 shadow-sm mb-8 select-none">
    <div class="flex items-center -space-x-1">
      <span class="w-2 h-2 rounded-full bg-[#1d77f2]"></span>
      <span class="w-2 h-2 rounded-full bg-[#1cb829]"></span>
    </div>
    <span class="text-xs font-black tracking-widest text-[#111d27] uppercase ml-1">
      LA NOSTRA VISIONE
    </span>
  </div>

  <blockquote class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#111d27] leading-[1.15] max-w-4xl mb-8">
    “Una città intelligente non spreca i suoi rifiuti, ma li trasforma in <span class="text-[#1d77f2]">dati</span>, <span class="text-[#1cb829]">inter-azioni</span> e nuove opportunità.”
  </blockquote>

  <p class="text-slate-500 text-sm sm:text-base font-medium mb-10">
    Samuele Ciman & Nicolò Prando — Co-founders di 4Loop
  </p>

  <div class="w-8 h-8 rounded-full border border-slate-200 flex items-center justify-center text-slate-400">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>