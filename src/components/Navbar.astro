---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 w-full bg-[#f7fafc]/90 backdrop-blur-md border-b border-slate-200/70 transition-all">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between">
    
    <a href="#" class="flex items-center gap-2 select-none group">
      <img 
        src="/logo.png" 
        alt="Logo 4Loop" 
        class="h-6 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105"
        loading="eager"
      />
    </a>

    <div class="flex items-center gap-3 sm:gap-6">
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-600">
        <a href="#processo" class="hover:text-[#111d27] transition-colors">Come funziona</a>
        <a href="#ecosistema" class="hover:text-[#111d27] transition-colors">Ecosistema</a>
        <a href="#impatto" class="hover:text-[#111d27] transition-colors">Impatto</a>
        <a href="#faq" class="hover:text-[#111d27] transition-colors">FAQ</a>
      </nav>

      <a
        href="#registrati"
        class="px-4 sm:px-6 py-2 sm:py-2.5 rounded-full bg-[#1cb829] hover:bg-[#18a224] active:scale-95 text-white font-semibold text-xs sm:text-sm transition-all shadow-sm shadow-[#1cb829]/20 shrink-0"
      >
        Entra in lista
      </a>
    </div>

  </div>
</header>