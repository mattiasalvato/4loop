---
// src/components/Process.astro

interface Step {
  stepNum: string;
  title: string;
  description: string;
  image: string;
  alt: string;
}

const steps: Step[] = [
  {
    stepNum: "01",
    title: "Smart Bin",
    description: "I cittadini conferiscono i capi nei contenitori intelligenti sul territorio urbano, guidati da mappatura dinamica e app dedicata.",
    image: "https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=600&q=80",
    alt: "Raccolta e sostenibilità urbana"
  },
  {
    stepNum: "02",
    title: "Blockchain",
    description: "Ogni lotto tessile viene digitalizzato e tracciato in modo immutabile: trasparenza e certezza del dato dal conferimento al riciclatore.",
    image: "https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=600&q=80",
    alt: "Natura e trasparenza"
  },
  {
    stepNum: "03",
    title: "Dashboard & KPI",
    description: "Brand e Pubblica Amministrazione monitorano in tempo reale volumi, impatto ambientale, metriche ESG e conformità normativa EPR.",
    image: "https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=600&q=80",
    alt: "Foresta e valorizzazione ambientale"
  }
];
---

<section id="processo" class="w-full bg-[#111d27] py-16 sm:py-24 overflow-hidden text-white">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 sm:mb-12">
      <div>
        <div class="flex items-center gap-2 mb-2 sm:mb-3">
          <span class="w-2 h-2 rounded-full bg-[#1d77f2]"></span>
          <span class="w-2 h-2 rounded-full bg-[#1cb829]"></span>
          <span class="text-[10px] sm:text-xs font-bold tracking-widest text-slate-300 uppercase ml-1">
            WORKFLOW PHYGITAL
          </span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-2 sm:mb-4">
          Come funziona
        </h2>
        <p class="text-slate-300 text-sm sm:text-base max-w-xl font-normal leading-relaxed">
          Dallo Smart Bin al nuovo prodotto: un'infrastruttura integrata per garantire trasparenza, tracciabilità e valorizzazione dell'intera filiera.
        </p>
      </div>

      <div class="hidden md:flex items-center gap-3">
        <button
          id="btn-process-prev"
          aria-label="Precedente"
          class="w-11 h-11 rounded-full bg-[#1d77f2] hover:bg-[#1663cc] active:scale-95 text-white flex items-center justify-center transition-all cursor-pointer shadow-md shadow-[#1d77f2]/20"
        >
          <svg class="w-5 h-5 stroke-[3] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="btn-process-next"
          aria-label="Successivo"
          class="w-11 h-11 rounded-full bg-[#1cb829] hover:bg-[#18a224] active:scale-95 text-white flex items-center justify-center transition-all cursor-pointer shadow-md shadow-[#1cb829]/20"
        >
          <svg class="w-5 h-5 stroke-[3] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Stack verticale pulito su mobile, slider snap su desktop -->
    <div
      id="process-slider"
      class="flex flex-col md:flex-row gap-5 md:gap-6 md:overflow-x-auto md:scroll-smooth md:snap-x md:snap-mandatory no-scrollbar pb-2"
    >
      {steps.map((step) => (
        <div class="md:snap-start flex-shrink-0 w-full md:w-[500px] lg:w-[540px] bg-[#0b131b] border border-slate-800/80 rounded-[2rem] p-6 sm:p-8 flex flex-col-reverse sm:flex-row items-center justify-between gap-5 sm:gap-6 shadow-xl">
          
          <div class="flex-1 flex flex-col justify-center text-left w-full">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-[#111d27] border border-slate-700 text-[#1cb829] text-[10px] sm:text-xs font-bold tracking-widest uppercase mb-2 sm:mb-3 w-fit">
              FASE {step.stepNum}
            </span>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white mb-2">
              {step.title}
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-light">
              {step.description}
            </p>
          </div>

          <div class="w-full sm:w-40 h-36 sm:h-48 rounded-2xl overflow-hidden shrink-0 border border-slate-800">
            <img src={step.image} alt={step.alt} class="w-full h-full object-cover" loading="lazy" />
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  const slider = document.getElementById('process-slider');
  const prev = document.getElementById('btn-process-prev');
  const next = document.getElementById('btn-process-next');

  if (slider && prev && next) {
    prev.addEventListener('click', () => { slider.scrollBy({ left: -450, behavior: 'smooth' }); });
    next.addEventListener('click', () => { slider.scrollBy({ left: 450, behavior: 'smooth' }); });
  }
</script>